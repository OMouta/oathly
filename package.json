{
  "name": "oathly-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docs:generate": "tsx scripts/generate-provider-docs.ts",
    "docs:check": "tsx scripts/generate-provider-docs.ts --check",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run docs:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "@changesets/cli": "^2.29.3",
    "publint": "^0.3.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
