{
  "name": "@oathly/node",
  "version": "0.1.0",
  "description": "Express/Fastify/http adapter for oathly: convert Node req/res to and from Web Request/Response.",
  "type": "module",
  "license": "MIT",
  "author": "OMouta",
  "homepage": "https://github.com/OMouta/oathly/tree/main/packages/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMouta/oathly.git",
    "directory": "packages/node"
  },
  "bugs": "https://github.com/OMouta/oathly/issues",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["oauth", "express", "fastify", "node", "oathly"],
  "devDependencies": {
    "@types/node": "^22.15.0",
    "oathly": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
