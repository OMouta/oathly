{
  "name": "oathly",
  "version": "0.1.0",
  "description": "Opinionated OAuth 2.0 and OpenID Connect client. Tokens and a verified identity, for any framework. You own your sessions.",
  "type": "module",
  "license": "MIT",
  "author": "OMouta",
  "homepage": "https://github.com/OMouta/oathly/tree/main/packages/oathly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMouta/oathly.git",
    "directory": "packages/oathly"
  },
  "bugs": "https://github.com/OMouta/oathly/issues",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["oauth", "oauth2", "oidc", "openid-connect", "auth", "pkce", "arctic"],
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
